      ],
      "shared_files": [
        "preview.html",
        "motion.css",
        "README.md"
      ],
      "rest_state": "Type specimen wall and selector chips",
      "hover_state": "Headline cycles through different type treatments and color variations",
      "motion_sequence": [
        "font samples cycle",
        "weight/size expand",
