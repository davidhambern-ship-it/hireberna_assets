      ],
      "status": "planned",
      "qa": {
        "assets_valid": false,
        "preview_tested": false,
        "github_verified": false
      }
    },
    {
      "id": "06",
      "slug": "export-publishing",
      "title": "Video Export & Publishing",
      "theme": "amber",
      "path": "promo-studio-assets/cards/export-publishing/",
      "visual_layers": [
        "base.svg",
        "video.svg",
        "mp4.svg",
        "progress-track.svg",
        "progress-fill.svg",
        "send-arrow.svg",
        "youtube.svg",
        "instagram.svg",
        "facebook.svg",
        "tiktok.svg",
        "check.svg"
      ],
      "shared_files": [
        "preview.html",
        "motion.css",
        "README.md"
      ],
      "rest_state": "Video export desk with MP4 file and platform destinations",
      "hover_state": "Render progress fills and video dispatches to four publishing channels",
      "motion_sequence": [
        "render progress reaches 100%",
        "MP4 appears",
        "send arrow travels",
        "channel indicators light up",
        "success appears"
      ],
      "status": "planned",
      "qa": {
        "assets_valid": false,
        "preview_tested": false,
        "github_verified": false
      }
    }
  ]
}
