        "chosen text rests bold"
      ],
      "status": "planned",
      "qa": {
        "assets_valid": false,
        "preview_tested": false,
        "github_verified": false
      }
    },
    {
      "id": "05",
      "slug": "visual-editor",
      "title": "Visual Editor",
      "theme": "blue",
      "path": "promo-studio-assets/cards/visual-editor/",
      "visual_layers": [
        "base.svg",
        "artwork.svg",
        "headline.svg",
        "sticker.svg",
        "guides.svg",
        "handles.svg",
        "cursor.svg",
        "finish.svg",
        "sparkles.svg"
      ],
      "shared_files": [
        "preview.html",
        "motion.css",
        "README.md"
      ],
      "rest_state": "Mini editing canvas with unsorted objects",
      "hover_state": "Artwork, text and sticker move along alignment guides into a polished layout",
      "motion_sequence": [
        "alignment guides appear",
